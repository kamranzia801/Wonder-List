<% layout("layouts/boilerplate") -%>
        <!-- <h3>All Listings</h3> -->
         <div id="filters">
            <div class="filter">
                <i class="fa-solid fa-fire f-icon"></i>
                <b>Trending</b>
            </div>
            <div class="filter">
                <i class="fa-solid fa-bed f-icon"></i>
                <b>Rooms</b>
            </div>
            <div class="filter">
                <i class="fa-solid fa-mountain-city f-icon"></i>
                <b>Iconic Cities</b>
            </div>
            <div class="filter">
                <i class="fa-solid fa-mountain-sun f-icon"></i>
                <b>Mountains</b>
            </div>
            <div class="filter">
                <i class="fa-solid fa-person-swimming f-icon"></i>
                <b>Amazing Pools</b>
            </div>

         </div>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(listing of listings){%>
                <div class="card cols">
                    <a href="/listings/<%=listing._id%>" style="text-decoration: none; display: inline; color: black;">
                        <img src="<%= listing.image.url%>" class="card-img-top" alt="property image">
                        <div class="card-img-overlay"></div>
                    </a>
                    <div class="card-body">
                        <a href="/listings/<%=listing._id%>"
                            style="text-decoration: none; display: inline; color: black;">
                            <p class="card-text " style="font-weight:700;">
                                <%=listing.title%>
                            </p>
                            <p class="card-text">
                                <%=listing.description%>
                            </p>
                            <p class="card-text"> &#8377; <%=listing.price.toLocaleString("en-IN")%>
                            </p>
                        </a>
                        <!-- <div class="buttons">
                            <form action="/listings/<%=listing._id%>/edit" method="get"><button>Edit</button></form>
                            <form action="/listings/<%=listing._id%>?_method=DELETE" method="POST">
                                <button>Delete</button>
                            </form>
                        </div> -->
                    </div>
                </div>
                <% } %>

        </div>
