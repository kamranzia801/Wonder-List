<% layout("layouts/boilerplate") -%>

    <body>
        <h3>Listing Details :</h3>
        <div class="card">
            <img src="<%= indlisting.image.url %>" class="card-img-top" alt="property image">
            <div class="card-body">
                <p class="card-text">
                    <b>
                        <%=indlisting.title %>
                    </b>
                    <br>
                    <%= indlisting.owner.username %>
                        <br>
                        <%= indlisting.description %>
                            <br>
                            &#8377;<%=indlisting.price.toLocaleString("en-IN")%>
                                <br>
                                <%=indlisting.location %>
                                    <br>
                                    <%=indlisting.country %>
                                        <br>
                                        <% if (userStatus && userStatus._id.equals(indlisting.owner._id)) { %>
                                            <div class="btns">
                                                <form style="display: inline-block;"
                                                    action="/listings/<%=indlisting._id%>/edit" method="get"><button
                                                        class="btn">Edit</button></form>
                                                <form style="display: inline-block;"
                                                    action="/listings/<%=indlisting._id%>?_method=DELETE" method="POST">
                                                    <button style="color: white;" class="btn">Delete</button>
                                                </form>
                                            </div>
                                            <% } %>
                </p>
            </div>
        </div>
        <div>
            <hr>
            <% if(userStatus ){%>
                <h4>Leave a Review</h4>
                <form action="/listings/<%=indlisting._id%>/reviews" method="post" novalidate class="needs-validation">
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
                            aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                    <div>
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" rows="5" cols="30" class="form-control"
                            required></textarea>
                    </div>
                    <button class="btn" type="submit">Submit</button>
                </form>
                <%}%>
                    <div class="card">
                        <hr>
                        <p> <b> All reviews </b></p>
                        <div class="row mb-3" id="review-row">
                            <% for(review of indlisting.reviews){ %>
                                <div class="card col-5 mb-3 ms-1" style="border: 1px solid black;">
                                    <div class="card-body">
                                        <h5 class="card-title">@<%= review.author.username %>
                                        </h5>
                                        <hr>
                                        <p class="card-text">
                                            <%=review.comment%>
                                        </p>
                                        <div class="starability-result" data-rating="<%= review.rating %>"
                                            aria-label="<%= review.rating %> out of 5 stars"></div>
                                    </div>
                                    <form class="m-3"
                                        action="/listings/<%=indlisting._id%>/reviews/<%=review._id%>?_method=DELETE"
                                        method="Post">
                                        <button class="btn btn-sm btn-dark">Delete</button>
                                    </form>
                                </div>
                                <% } %>
                        </div>
                    </div>
        </div>
        <div class="mb-3 ">
            <h3>Where you will be</h3>
            <div id="map"
                data-map-token="<%= process.env.MAP_TOKEN || '' %>"
                data-location="<%= indlisting.location %>, <%= indlisting.country %>"></div>
        </div>

        <script src="/js/map.js"></script>
    </body>