<% layout("layouts/boilerplate") -%>
    <h3>Create a New Listing</h3>
    <form action="/listings/<%=indlisting._id%>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        <div >
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" value="<%=indlisting.title%>" name="listing[title]">
        </div>
        <div>
            <label for="description" class="form-label">Description</label>
            <input type="text" class="form-control" value="<%-indlisting.description%>" name="listing[description]">
        </div>
        <div class="mb-3">
            <img src="<%= originalImageUrl %>" alt="">
        </div>
        <div>
            <label for="image" class="form-label">Upload New Image</label>
            <input class="form-control" type="file" name="listing[image]">
        </div>
        <div>
            <label for="price" class="form-label">Price</label>
            <input class="form-control" type="number" value="<%-indlisting.price%>" name="listing[price]" required min="0">
        </div>
        <div>
            <label for="location" class="form-label">Location</label>
            <input class="form-control" type="text" value="<%-indlisting.location%>" name="listing[location]"required>
        </div>
        <div>
            <label for="country" class="form-label">Country</label>
            <input class="form-control" type="text" value="<%-indlisting.country%>" name="listing[country]">
        </div>
        <button type="submit" class="btn btn-primary">Enter</button>
    </form>
